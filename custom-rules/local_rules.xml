<!-- Iteration 2: More specific (if_sid + field), but audit rule scope was too broad -->
<!-- (captured local Unix socket traffic alongside real network connections) -->
<group name="custom,recon,">
  <rule id="100100" level="7">
    <if_sid>80700</if_sid>
    <field name="audit.type">SYSCALL</field>
    <description>Possible network connection detected via auditd monitoring - potential port scan</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>
</group>

<!-- Status: Unresolved / Future Work -->
<!-- Root cause: the auditctl rule (-S connect,accept -F arch=b64) monitors ALL -->
<!-- connect/accept syscalls indiscriminately, including high-volume local socket -->
<!-- traffic (PAM auth, systemd internals) that drowns out signal from actual -->
<!-- external network scans. Additionally, Nmap's default SYN scan does not -->
<!-- complete a full TCP handshake, so it may never trigger accept() at the -->
<!-- application layer. Resolving this requires scoping the audit rule to -->
<!-- saddr_fam=inet explicitly, and/or testing with full TCP connect scans. -->

